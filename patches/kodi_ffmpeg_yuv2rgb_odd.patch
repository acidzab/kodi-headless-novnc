From dea0b86d80489a839e81e10af830202869265fce Mon Sep 17 00:00:00 2001
From: Dom Cobley <popcornmix@gmail.com>
Date: Tue, 10 Nov 2026 15:55:10 +0000
Subject: [PATCH] [depends][ffmpeg] Write the last pixel of odd width yuv2rgb
 rows

libswscale's C YUV420P/YUV422P/YUVA420P to RGB converters fill each row
in blocks of 8, 4 and 2 pixels, so with an odd output width the last
column is never written. On ARM, where the NEON versions only take
widths divisible by 16, this shows up as a line of random pixels on the
right edge of odd width posters.

Carry the fix submitted upstream until it lands in an FFmpeg release:
https://code.ffmpeg.org/FFmpeg/FFmpeg/pulls/25723
---
 cmake/modules/FindFFMPEG.cmake                |   3 +
 ...ffmpeg-all-swscale-yuv2rgb-odd-width.patch | 221 ++++++++++++++++++
 tools/depends/target/ffmpeg/CMakeLists.txt    |   1 +
 tools/depends/target/ffmpeg/Makefile          |   5 +-
 4 files changed, 228 insertions(+), 2 deletions(-)
 create mode 100644 tools/depends/target/ffmpeg/009-ffmpeg-all-swscale-yuv2rgb-odd-width.patch

diff --git a/cmake/modules/FindFFMPEG.cmake b/cmake/modules/FindFFMPEG.cmake
index 2ef6a53a126e9..e1d8c701cac95 100644
--- a/cmake/modules/FindFFMPEG.cmake
+++ b/cmake/modules/FindFFMPEG.cmake
@@ -222,6 +222,9 @@ macro(buildFFMPEG)
                       COMMAND ${CMAKE_COMMAND} -E copy
                       ${CMAKE_SOURCE_DIR}/tools/depends/target/ffmpeg/008-ffmpeg-all-pgssubdec-use-caller-colorspace.patch
                       <SOURCE_DIR>
+                      COMMAND ${CMAKE_COMMAND} -E copy
+                      ${CMAKE_SOURCE_DIR}/tools/depends/target/ffmpeg/009-ffmpeg-all-swscale-yuv2rgb-odd-width.patch
+                      <SOURCE_DIR>
     )
 
     if(NOT DISABLE_FFMPEG_SOURCE_PLUGINS)
diff --git a/tools/depends/target/ffmpeg/009-ffmpeg-all-swscale-yuv2rgb-odd-width.patch b/tools/depends/target/ffmpeg/009-ffmpeg-all-swscale-yuv2rgb-odd-width.patch
new file mode 100644
index 0000000000000..6cb28b6be0344
--- /dev/null
+++ b/tools/depends/target/ffmpeg/009-ffmpeg-all-swscale-yuv2rgb-odd-width.patch
@@ -0,0 +1,221 @@
+diff --git a/libswscale/yuv2rgb.c b/libswscale/yuv2rgb.c
+index a430a110db7..042cc1cc58f 100644
+--- a/libswscale/yuv2rgb.c
++++ b/libswscale/yuv2rgb.c
+@@ -78,6 +78,10 @@ const int *sws_getCoefficients(int colorspace)
+     Y                  = py_##l[2 * i + 1];         \
+     dst_##l[2 * i + 1] = r[Y] + g[Y] + b[Y];
+ 
++#define PUTRGB_ODD(l, i, abase)                     \
++    Y                  = py_##l[2 * i];             \
++    dst_##l[2 * i]     = r[Y] + g[Y] + b[Y];
++
+ #define PUTRGB24(l, i, abase)                       \
+     Y                  = py_##l[2 * i];             \
+     dst_##l[6 * i + 0] = r[Y];                      \
+@@ -88,6 +92,12 @@ const int *sws_getCoefficients(int colorspace)
+     dst_##l[6 * i + 4] = g[Y];                      \
+     dst_##l[6 * i + 5] = b[Y];
+ 
++#define PUTRGB24_ODD(l, i, abase)                   \
++    Y                  = py_##l[2 * i];             \
++    dst_##l[6 * i + 0] = r[Y];                      \
++    dst_##l[6 * i + 1] = g[Y];                      \
++    dst_##l[6 * i + 2] = b[Y];
++
+ #define PUTBGR24(l, i, abase)                       \
+     Y                  = py_##l[2 * i];             \
+     dst_##l[6 * i + 0] = b[Y];                      \
+@@ -98,12 +108,22 @@ const int *sws_getCoefficients(int colorspace)
+     dst_##l[6 * i + 4] = g[Y];                      \
+     dst_##l[6 * i + 5] = r[Y];
+ 
++#define PUTBGR24_ODD(l, i, abase)                   \
++    Y                  = py_##l[2 * i];             \
++    dst_##l[6 * i + 0] = b[Y];                      \
++    dst_##l[6 * i + 1] = g[Y];                      \
++    dst_##l[6 * i + 2] = r[Y];
++
+ #define PUTRGBA(l, i, abase)                        \
+     Y                  = py_##l[2 * i];             \
+     dst_##l[2 * i]     = r[Y] + g[Y] + b[Y] + ((uint32_t)(pa_##l[2 * i])     << abase); \
+     Y                  = py_##l[2 * i + 1];         \
+     dst_##l[2 * i + 1] = r[Y] + g[Y] + b[Y] + ((uint32_t)(pa_##l[2 * i + 1]) << abase);
+ 
++#define PUTRGBA_ODD(l, i, abase)                    \
++    Y                  = py_##l[2 * i];             \
++    dst_##l[2 * i]     = r[Y] + g[Y] + b[Y] + ((uint32_t)(pa_##l[2 * i])     << abase);
++
+ #define PUTRGB48(l, i, abase)                       \
+     Y                    = py_##l[ 2 * i];          \
+     dst_##l[12 * i +  0] = dst_##l[12 * i +  1] = r[Y]; \
+@@ -114,6 +134,12 @@ const int *sws_getCoefficients(int colorspace)
+     dst_##l[12 * i +  8] = dst_##l[12 * i +  9] = g[Y]; \
+     dst_##l[12 * i + 10] = dst_##l[12 * i + 11] = b[Y];
+ 
++#define PUTRGB48_ODD(l, i, abase)                   \
++    Y                    = py_##l[ 2 * i];          \
++    dst_##l[12 * i +  0] = dst_##l[12 * i +  1] = r[Y]; \
++    dst_##l[12 * i +  2] = dst_##l[12 * i +  3] = g[Y]; \
++    dst_##l[12 * i +  4] = dst_##l[12 * i +  5] = b[Y];
++
+ #define PUTBGR48(l, i, abase)                       \
+     Y                    = py_##l[2 * i];           \
+     dst_##l[12 * i +  0] = dst_##l[12 * i +  1] = b[Y]; \
+@@ -124,6 +150,12 @@ const int *sws_getCoefficients(int colorspace)
+     dst_##l[12 * i +  8] = dst_##l[12 * i +  9] = g[Y]; \
+     dst_##l[12 * i + 10] = dst_##l[12 * i + 11] = r[Y];
+ 
++#define PUTBGR48_ODD(l, i, abase)                   \
++    Y                    = py_##l[2 * i];           \
++    dst_##l[12 * i +  0] = dst_##l[12 * i +  1] = b[Y]; \
++    dst_##l[12 * i +  2] = dst_##l[12 * i +  3] = g[Y]; \
++    dst_##l[12 * i +  4] = dst_##l[12 * i +  5] = r[Y];
++
+ #define PUTGBRP(l, i, abase)                        \
+     Y                   = py_##l[2 * i];            \
+     dst_##l [2 * i + 0] = g[Y];                     \
+@@ -134,6 +166,12 @@ const int *sws_getCoefficients(int colorspace)
+     dst1_##l[2 * i + 1] = b[Y];                     \
+     dst2_##l[2 * i + 1] = r[Y];
+ 
++#define PUTGBRP_ODD(l, i, abase)                    \
++    Y                   = py_##l[2 * i];            \
++    dst_##l [2 * i + 0] = g[Y];                     \
++    dst1_##l[2 * i + 0] = b[Y];                     \
++    dst2_##l[2 * i + 0] = r[Y];
++
+ #define YUV2RGBFUNC(func_name, dst_type, alpha, yuv422, nb_dst_planes)      \
+     static int func_name(SwsInternal *c, const uint8_t *const src[],         \
+                          const int srcStride[], int srcSliceY, int srcSliceH, \
+@@ -233,6 +271,10 @@ const int *sws_getCoefficients(int colorspace)
+         LOADCHROMA(1, 0);                                               \
+         PUTFUNC(1, 0, abase);                                           \
+         PUTFUNC(2, 0, abase);                                           \
++    ENDYUV2RGBLINE(dst_delta, 2, alpha, 0, nb_dst_planes)               \
++        LOADCHROMA(1, 0);                                               \
++        PUTFUNC##_ODD(1, 0, abase);                                     \
++        PUTFUNC##_ODD(2, 0, abase);                                     \
+     ENDYUV2RGBFUNC()
+ 
+ #define YUV422FUNC(func_name, dst_type, alpha, abase, PUTFUNC, dst_delta, nb_dst_planes) \
+@@ -278,6 +320,12 @@ const int *sws_getCoefficients(int colorspace)
+                                                                         \
+         LOADCHROMA(2, 0);                                               \
+         PUTFUNC(2, 0, abase);                                           \
++    ENDYUV2RGBLINE(dst_delta, 2, alpha, 1, nb_dst_planes)               \
++        LOADCHROMA(1, 0);                                               \
++        PUTFUNC##_ODD(1, 0, abase);                                     \
++                                                                        \
++        LOADCHROMA(2, 0);                                               \
++        PUTFUNC##_ODD(2, 0, abase);                                     \
+     ENDYUV2RGBFUNC()
+ 
+ #define YUV420FUNC_DITHER(func_name, dst_type, LOADDITHER, PUTFUNC, dst_delta) \
+@@ -315,6 +363,12 @@ const int *sws_getCoefficients(int colorspace)
+         LOADCHROMA(1, 0);                                               \
+         PUTFUNC(1, 0, 0);                                               \
+         PUTFUNC(2, 0, 0 + 8);                                           \
++    ENDYUV2RGBLINE(dst_delta, 2, 0, 0, 1)                               \
++        LOADDITHER                                                      \
++                                                                        \
++        LOADCHROMA(1, 0);                                               \
++        PUTFUNC##_ODD(1, 0, (c->opts.dst_w & 6));                       \
++        PUTFUNC##_ODD(2, 0, ((c->opts.dst_w & 6) + 8));                 \
+     ENDYUV2RGBFUNC()
+ 
+ #define YUV422FUNC_DITHER(func_name, dst_type, LOADDITHER, PUTFUNC, dst_delta) \
+@@ -366,6 +420,14 @@ const int *sws_getCoefficients(int colorspace)
+                                                                         \
+         LOADCHROMA(2, 0);                                               \
+         PUTFUNC(2, 0, 0 + 8);                                           \
++    ENDYUV2RGBLINE(dst_delta, 2, 0, 1, 1)                               \
++        LOADDITHER                                                      \
++                                                                        \
++        LOADCHROMA(1, 0);                                               \
++        PUTFUNC##_ODD(1, 0, (c->opts.dst_w & 6));                       \
++                                                                        \
++        LOADCHROMA(2, 0);                                               \
++        PUTFUNC##_ODD(2, 0, ((c->opts.dst_w & 6) + 8));                 \
+     ENDYUV2RGBFUNC()
+ 
+ #define LOADDITHER16                                    \
+@@ -383,6 +445,12 @@ const int *sws_getCoefficients(int colorspace)
+                          g[Y + e16[1 + o]] +        \
+                          b[Y + f16[1 + o]];
+ 
++#define PUTRGB16_ODD(l, i, o)                       \
++    Y                  = py_##l[2 * i];             \
++    dst_##l[2 * i]     = r[Y + d16[0 + o]] +        \
++                         g[Y + e16[0 + o]] +        \
++                         b[Y + f16[0 + o]];
++
+ #define LOADDITHER15                                    \
+     const uint8_t *d16 = ff_dither_2x2_8[y & 1];        \
+     const uint8_t *e16 = ff_dither_2x2_8[(y & 1)^1];
+@@ -397,6 +465,12 @@ const int *sws_getCoefficients(int colorspace)
+                          g[Y + d16[0 + o]] +        \
+                          b[Y + e16[1 + o]];
+ 
++#define PUTRGB15_ODD(l, i, o)                       \
++    Y                  = py_##l[2 * i];             \
++    dst_##l[2 * i]     = r[Y + d16[0 + o]] +        \
++                         g[Y + d16[1 + o]] +        \
++                         b[Y + e16[0 + o]];
++
+ #define LOADDITHER12                                    \
+     const uint8_t *d16 = ff_dither_4x4_16[y & 3];
+ 
+@@ -410,6 +484,12 @@ const int *sws_getCoefficients(int colorspace)
+                          g[Y + d16[1 + o]] +        \
+                          b[Y + d16[1 + o]];
+ 
++#define PUTRGB12_ODD(l, i, o)                       \
++    Y                  = py_##l[2 * i];             \
++    dst_##l[2 * i]     = r[Y + d16[0 + o]] +        \
++                         g[Y + d16[0 + o]] +        \
++                         b[Y + d16[0 + o]];
++
+ #define LOADDITHER8                                     \
+     const uint8_t *d32 = ff_dither_8x8_32[yd & 7];      \
+     const uint8_t *d64 = ff_dither_8x8_73[yd & 7];
+@@ -424,6 +504,12 @@ const int *sws_getCoefficients(int colorspace)
+                          g[Y + d32[1 + o]] +        \
+                          b[Y + d64[1 + o]];
+ 
++#define PUTRGB8_ODD(l, i, o)                        \
++    Y                  = py_##l[2 * i];             \
++    dst_##l[2 * i]     = r[Y + d32[0 + o]] +        \
++                         g[Y + d32[0 + o]] +        \
++                         b[Y + d64[0 + o]];
++
+ #define LOADDITHER4D                                    \
+     const uint8_t * d64 = ff_dither_8x8_73[yd & 7];     \
+     const uint8_t *d128 = ff_dither_8x8_220[yd & 7];    \
+@@ -440,6 +526,13 @@ const int *sws_getCoefficients(int colorspace)
+               b[Y + d128[1 + o]]) << 4;             \
+     dst_##l[i] = acc;
+ 
++#define PUTRGB4D_ODD(l, i, o)                       \
++    Y      = py_##l[2 * i];                         \
++    acc    = r[Y + d128[0 + o]] +                   \
++             g[Y +  d64[0 + o]] +                   \
++             b[Y + d128[0 + o]];                    \
++    dst_##l[i] = acc << 4;
++
+ #define LOADDITHER4DB                                   \
+     const uint8_t *d64  = ff_dither_8x8_73[yd & 7];     \
+     const uint8_t *d128 = ff_dither_8x8_220[yd & 7];
+@@ -454,6 +547,12 @@ const int *sws_getCoefficients(int colorspace)
+                          g[Y +  d64[1 + o]] +       \
+                          b[Y + d128[1 + o]];
+ 
++#define PUTRGB4DB_ODD(l, i, o)                      \
++    Y                  = py_##l[2 * i];             \
++    dst_##l[2 * i]     = r[Y + d128[0 + o]] +       \
++                         g[Y +  d64[0 + o]] +       \
++                         b[Y + d128[0 + o]];
++
+ YUV2RGBFUNC(yuv2rgb_c_1_ordered_dither, uint8_t, 0, 0, 1)
+     const uint8_t *d128 = ff_dither_8x8_220[yd & 7];
+     char out_1 = 0, out_2 = 0;
diff --git a/tools/depends/target/ffmpeg/CMakeLists.txt b/tools/depends/target/ffmpeg/CMakeLists.txt
index 44f92e795ba9f..32dcfb1e6dfe3 100644
--- a/tools/depends/target/ffmpeg/CMakeLists.txt
+++ b/tools/depends/target/ffmpeg/CMakeLists.txt
@@ -165,6 +165,7 @@ else()
   set(sourceplugin_patch PATCH_COMMAND patch -p1 -i <SOURCE_DIR>/002-ffmpeg-libavutil-common-h-cpp11-constant-macros.patch)
 endif()
 list(APPEND sourceplugin_patch COMMAND patch -p1 -i <SOURCE_DIR>/008-ffmpeg-all-pgssubdec-use-caller-colorspace.patch)
+list(APPEND sourceplugin_patch COMMAND patch -p1 -i <SOURCE_DIR>/009-ffmpeg-all-swscale-yuv2rgb-odd-width.patch)
 
 include(ExternalProject)
 externalproject_add(ffmpeg
diff --git a/tools/depends/target/ffmpeg/Makefile b/tools/depends/target/ffmpeg/Makefile
index 53da6f9457451..b7180cd8c903c 100644
--- a/tools/depends/target/ffmpeg/Makefile
+++ b/tools/depends/target/ffmpeg/Makefile
@@ -4,7 +4,8 @@ DEPS = FFMPEG-VERSION Makefile ../../download-files.include \
                       CMakeLists.txt \
                       001-ffmpeg-all-libpostproc-plugin.patch \
                       002-ffmpeg-libavutil-common-h-cpp11-constant-macros.patch \
-                      008-ffmpeg-all-pgssubdec-use-caller-colorspace.patch
+                      008-ffmpeg-all-pgssubdec-use-caller-colorspace.patch \
+                      009-ffmpeg-all-swscale-yuv2rgb-odd-width.patch
 
 BUILD_TYPE = Release
 ifeq ($(DEBUG_BUILD),yes)
@@ -47,7 +48,7 @@ all: .installed-$(PLATFORM)
 	rm -rf $(PLATFORM); mkdir -p $(PLATFORM)/build
 	cd $(PLATFORM); $(ARCHIVE_TOOL) $(ARCHIVE_TOOL_FLAGS) $(TARBALLS_LOCATION)/$(ARCHIVE)
 	cd $(PLATFORM); cp ../CMakeLists.txt ./
-	cd $(PLATFORM); cp ../001-ffmpeg-all-libpostproc-plugin.patch ../002-ffmpeg-libavutil-common-h-cpp11-constant-macros.patch ../008-ffmpeg-all-pgssubdec-use-caller-colorspace.patch ./
+	cd $(PLATFORM); cp ../001-ffmpeg-all-libpostproc-plugin.patch ../002-ffmpeg-libavutil-common-h-cpp11-constant-macros.patch ../008-ffmpeg-all-pgssubdec-use-caller-colorspace.patch ../009-ffmpeg-all-swscale-yuv2rgb-odd-width.patch ./
 	cd $(PLATFORM)/build; $(CMAKE) $(CMAKE_ARGS) ..
 	touch $@
 
